# ═══════════════════════════════════════════════════════════
# AI-Powered Fitness Coach — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── FastAPI ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── ML Pipeline ────────────────────────────────────────────
MODEL_DIR=./models
DATA_DIR=./data
DATASET_DIR=./Dataset

# Frame sampling rate for video processing
FRAME_SAMPLE_RATE=3

# Minimum MediaPipe landmark visibility threshold
MIN_LANDMARK_VISIBILITY=0.5

# Exercise recognition confidence threshold
EXERCISE_CONFIDENCE_THRESHOLD=0.6

# ── Video Upload Limits ────────────────────────────────────
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
MAX_VIDEO_DURATION_SECONDS=300

# ── Rate Limiting ──────────────────────────────────────────
AUTH_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=5/hour
ANALYSIS_RATE_LIMIT=10/day

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
